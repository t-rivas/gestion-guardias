DATABASE_URL=postgresql+psycopg://guardias:guardias@localhost:5433/guardias
SQLALCHEMY_ECHO=false
APP_HOST=127.0.0.1
APP_BIND_HOST=127.0.0.1
APP_PORT=8001
APP_RELOAD=true
# Generate a random secret: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=
COOKIE_SECURE=false
TRUSTED_ORIGINS=
POSTGRES_USER=guardias
POSTGRES_PASSWORD=guardias
POSTGRES_DB=guardias
POSTGRES_PORT=5433

# Password mode is for existing local development only. Vercel requires neon.
APP_ENV=development
AUTH_MODE=password
# Use .env.private-access for isolated preview credentials; retain the local .env.
ALLOWED_EMAILS=thiago.rivas0021@gmail.com
APP_BASE_URL=
NEON_AUTH_BASE_URL=
# Direct Neon URL for explicit Alembic/backup operations (DATABASE_URL is pooled).
MIGRATION_DATABASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
# Local setup tools only; never deploy this administrative key.
NEON_PROJECT_ID=
NEON_BRANCH_ID=
NEON_API_KEY=

# Delivery-only webhook: optional exact HTTPS origins sharing one Neon branch.
# AUTH_EMAIL_ORIGINS=https://your-production.example,https://your-preview.example
